# Start a timer and turn an output on when the timer starts and off when the timer expires

# Note: Machines can be defined and instantiated in any order.
switch TimedSwitch global_timer, flag;
global_timer Timer;
flag    FLAG;

TimedSwitch MACHINE timer, output {
  # The output should be turned off within the Running state.
  Error WHEN SELF IS Done AND output IS on; 
  Done WHEN timer IS expired;

  Error WHEN SELF IS Running AND TIMER > timer.expiry_time;

  Running WHEN timer IS running;
    
  ENTER Error { LOG "Delay did not complete in " + timer.expiry_time + "ms"; }

  ENTER Done { LOG "done"; }
  RECEIVE timer.running_enter{ LOG "timer is running"; }
  RECEIVE timer.expired_enter{ LOG "timer has expired"; }

  ENTER Running {
    LOG "before first if";
    IF ( timer IS running ) {
      SET output TO on;
      LOG "First Test";
    };
    WAITFOR timer IS expired;
    LOG "after first if";
    IF ( timer IS expired ) {
      SET output TO off;
      LOG "Second Test";
    };
    LOG "after second if";
  }
  
  ENTER INIT {
    # initialisation order is not guaranteed, wait
    # for the timer to be initialised before starting it.
    WAITFOR timer IS stopped;
    LOG "starting timer"; SEND start TO timer;
  }
}

Timer MACHINE {
  OPTION expiry_time 1000;
  # There is no default state here so the machine won't leave running
  # until the test on expired becomes true.
  expired WHEN SELF IS expired || (SELF IS running && TIMER >=expiry_time);

  running STATE;
  stopped INITIAL;

  TRANSITION stopped TO running USING start;
  TRANSITION ANY TO stopped USING reset;
}
